        "openai",
        "gemini",
        "anthropic",
        "claude",
        "gpt",
        "mcp",
        "model-context-protocol",
        "ai-agent",
        "agent",
        "issue-tracker",
        "project-management",
        "task-management",
        "sprint",
        "kanban",
        "scrum",
        "agile",
        "command-line",
        "interactive",
        "terminal",
        "developer-tools",
        "devtools",
        "productivity",
        "workflow",
        "git-integration"
    ],
    "author": {
        "name": "Arul",
        "url": "https://github.com/Aarul5"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Aarul5/jira-pilot.git"
    },
    "bugs": {
        "url": "https://github.com/Aarul5/jira-pilot/issues"
    },
    "homepage": "https://github.com/Aarul5/jira-pilot#readme",
    "license": "ISC",
